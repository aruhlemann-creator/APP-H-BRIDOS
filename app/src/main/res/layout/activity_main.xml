<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:keepScreenOn="true">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Receptor VLC"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#0A2A66"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detecção de Comunicação Óptica (OOK)"
            android:textAlignment="center"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"
            android:textColor="#444444"/>

        <!-- Card taxa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Taxa de bits (bits/s)"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/editBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ex: 5"
                android:inputType="number"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Botões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartRx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Iniciar"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                app:cornerRadius="0dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopRx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Parar"
                android:backgroundTint="#C62828"
                android:textColor="#FFFFFF"
                app:cornerRadius="0dp"/>

        </LinearLayout>

        <!-- Sensor de luminosidade -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensor de Luminosidade (Lux)"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/textLux"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#ECEFF1"
            android:padding="10dp"
            android:textSize="16sp"
            android:textColor="#000000"/>

        <!-- Bits recebidos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bits Recebidos"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/textBits"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#ECEFF1"
            android:padding="10dp"
            android:textSize="16sp"
            android:textColor="#000000"/>

        <!-- Mensagem decodificada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensagem Decodificada"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/textMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#ECEFF1"
            android:padding="10dp"
            android:textSize="18sp"
            android:textColor="#000000"/>

    </LinearLayout>

</ScrollView>